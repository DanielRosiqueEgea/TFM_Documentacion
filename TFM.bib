@incollection{subasi_Chapter42019,
  title = {Chapter 4 - {{Feature Extraction}} and {{Dimension Reduction}}},
  booktitle = {Practical {{Guide}} for {{Biomedical Signals Analysis Using Machine Learning Techniques}}},
  author = {Subasi, Abdulhamit},
  date = {2019-01-01},
  pages = {193--275},
  publisher = {Academic Press},
  doi = {10.1016/B978-0-12-817444-9.00004-0},
  url = {https://www.sciencedirect.com/science/article/pii/B9780128174449000040},
  urldate = {2026-07-02},
  abstract = {Feature extraction and dimension reduction are required to achieve better performance for the classification of biomedical signals. The aim of feature extraction is to find the most compacted and informative set of features (distinct patterns) to enhance the efficiency of the classifier. Moreover, feature extraction is employed to extract features from the original signal to accomplish reliable classification. Feature extraction is the most crucial part of biomedical signal classification because the classification performance might be degraded if the features are not selected well. In dimension reduction/feature selection, the minimum subset of features is chosen from the original set of features, which achieves maximum generalization ability. To accomplish this, during the process of dimension reduction/feature selection, several types of techniques such as principal component analysis (PCA), independent component analysis (ICA), linear discriminant analysis (LDA), statistical values, and different entropy measures can be employed. Dimension reduction/feature selection can be combined with a feature extraction algorithm to reduce the dimension to select the most appropriate features for classification. The aim of this chapter is to assist researchers or biomedical engineers in choosing a suitable feature extraction and dimension reduction method, and then guide them for optimal strategy by using publicly available biomedical signal databases. Hence the fundamental feature extraction and dimension reduction techniques that are employed for the classification of the biomedical signals are discussed in this chapter. Toward the end of each section, proper MATLAB functions with different biomedical signal applications will be illustrated by an example.},
