@article{jiang_ComprehensiveReview2026,
  title = {A Comprehensive Review of Deep Learning for Motor Imagery {{EEG}}: {{From}} Healthy Subjects to Patients},
  shorttitle = {A Comprehensive Review of Deep Learning for Motor Imagery {{EEG}}},
  author = {Jiang, Bin and Wang, Xiangkai and He, Dongyi and Cheng, Siyu and Liao, Maoyu and Miao, Duoqian and Xia, Qingling and Zhao, Yun and Li, Gen},
  date = {2026-05-15},
  journaltitle = {Biomedical Signal Processing and Control},
  shortjournal = {Biomedical Signal Processing and Control},
  volume = {117},
  pages = {109680},
  issn = {1746-8094},
  doi = {10.1016/j.bspc.2026.109680},
  url = {https://www.sciencedirect.com/science/article/pii/S174680942600234X},
  urldate = {2026-05-05},
  abstract = {Motor imagery-based electroencephalography (MI-EEG) decoding has become a foundational technique in braincomputer interface (BCI) systems, offering promising assistive and rehabilitative applications for individuals with motor impairments, including stroke, spinal cord injury, and Parkinson’s diseases. This review provides a systematic and indepth survey of deep learning approaches for MI-EEG decoding, with a particular emphasis on fusion mechanisms across model architectures, subject populations, and data paradigms. We firstly categorize and examine representative models developed for healthy subjects under single-subject and cross-subject schemes, emphasizing their architectural evolution and limitations in generalization—thereby establishing the basis for subsequent structural fusion. Experimental results reveal substantial performance degradation when transferring these models to patient EEG data, underscoring the need for population-adaptive modeling. We further analyze recently proposed frameworks specifically designed for clinical populations, highlighting their structural flexibility and task-specific alignment. This structural complementarity between healthy-subject and patient-centric models exemplifies a cross-paradigm fusion strategy at the architectural level. Beyond model design, we systematically compare public datasets from healthy subjects, condition-specific datasets from patients, and institutionally curated clinical datasets. The comparative results identify a closed-loop fusion trend that promotes synergistic integration of heterogeneous data sources, paving the way for generalized yet personalized MI-EEG decoding. Finally, we outline current challenges and future research directions centered on multimodal fusion, lightweight modeling, and clinically deployable BCI systems. This review advocates a clinically informed fusion paradigm that bridges algorithm development and real-world rehabilitation, promoting patient-centered, generalizable, and portable MI-EEG decoding technologies.},
  keywords = {Clinical applications,Cross-population fusion,Deep learning,EEG decoding,Motor imagery},
  file = {/home/roxoner/Zotero/storage/R7Y2QYMA/Jiang et al. - 2026 - A comprehensive review of deep learning for motor imagery EEG From healthy subjects to patients.pdf;/home/roxoner/Zotero/storage/TF5JXNIA/S174680942600234X.html}
}

@article{khadka_DREAMSPython2025,
  title = {{{DREAMS}}: {{A}} Python Framework for Training Deep Learning Models on {{EEG}} Data with Model Card Reporting for Medical Applications},
  shorttitle = {{{DREAMS}}},
  author = {Khadka, Rabindra and Lind, Pedro G. and Yazidi, Anis and Belhadi, Asma},
  date = {2025-05-01},
  journaltitle = {SoftwareX},
  shortjournal = {SoftwareX},
  volume = {30},
  pages = {102140},
  issn = {2352-7110},
  doi = {10.1016/j.softx.2025.102140},
  url = {https://www.sciencedirect.com/science/article/pii/S2352711025001074},
  urldate = {2025-11-13},
  abstract = {Electroencephalography (EEG) provides a non-invasive way to observe brain activity in real time. Deep learning has enhanced EEG analysis, enabling meaningful pattern detection for clinical and research purposes. However, most existing frameworks for EEG data analysis are either focused on preprocessing techniques or deep learning model development, often overlooking the crucial need for structured documentation and model interpretability. In this paper, we introduce DREAMS (Deep REport for AI ModelS), a Python-based framework designed to generate automated model cards for deep learning models applied to EEG data. Unlike generic model reporting tools, DREAMS is specifically tailored for EEG-based deep learning applications, incorporating domain-specific metadata, preprocessing details, performance metrics, and uncertainty quantification. The framework seamlessly integrates with deep learning pipelines, providing structured YAML-based documentation. We evaluate DREAMS through two case studies: an EEG emotion classification task using the FACED dataset and a abnormal EEG classification task using the Temple University Hospital (TUH) Abnormal dataset. These evaluations demonstrate how the generated model card enhances transparency by documenting model performance, dataset biases, and interpretability limitations. Unlike existing model documentation approaches, DREAMS provides visualized performance metrics, dataset alignment details, and model uncertainty estimations, making it a valuable tool for researchers and clinicians working with EEG-based AI. The source code for DREAMS is open-source, facilitating broad adoption in healthcare AI, research, and ethical AI development.},
  keywords = {Deep learning,Electroencephalography,Model card,Python},
  file = {/home/roxoner/Zotero/storage/UYCWMN7S/Khadka et al. - 2025 - DREAMS A python framework for training deep learning models on EEG data with model card reporting f.pdf;/home/roxoner/Zotero/storage/ML93YLPJ/S2352711025001074.html}
}

@article{kilicarslan_RobustAdaptive2016,
  title = {A Robust Adaptive Denoising Framework for Real-Time Artifact Removal in Scalp {{EEG}} Measurements},
  author = {Kilicarslan, Atilla and Grossman, Robert G. and Contreras-Vidal, Jose Luis},
  date = {2016-04},
  journaltitle = {Journal of Neural Engineering},
  shortjournal = {J Neural Eng},
  volume = {13},
  number = {2},
  eprint = {26863159},
  eprinttype = {pubmed},
  pages = {026013},
  issn = {1741-2552},
  doi = {10.1088/1741-2560/13/2/026013},
  abstract = {OBJECTIVE: Non-invasive measurement of human neural activity based on the scalp electroencephalogram (EEG) allows for the development of biomedical devices that interface with the nervous system for scientific, diagnostic, therapeutic, or restorative purposes. However, EEG recordings are often considered as prone to physiological and non-physiological artifacts of different types and frequency characteristics. Among them, ocular artifacts and signal drifts represent major sources of EEG contamination, particularly in real-time closed-loop brain-machine interface (BMI) applications, which require effective handling of these artifacts across sessions and in natural settings. APPROACH: We extend the usage of a robust adaptive noise cancelling (ANC) scheme ([Formula: see text] filtering) for removal of eye blinks, eye motions, amplitude drifts and recording biases simultaneously. We also characterize the volume conduction, by estimating the signal propagation levels across all EEG scalp recording areas due to ocular artifact generators. We find that the amplitude and spatial distribution of ocular artifacts vary greatly depending on the electrode location. Therefore, fixed filtering parameters for all recording areas would naturally hinder the true overall performance of an ANC scheme for artifact removal. We treat each electrode as a separate sub-system to be filtered, and without the loss of generality, they are assumed to be uncorrelated and uncoupled. MAIN RESULTS: Our results show over 95-99.9\% correlation between the raw and processed signals at non-ocular artifact regions, and depending on the contamination profile, 40-70\% correlation when ocular artifacts are dominant. We also compare our results with the offline independent component analysis and artifact subspace reconstruction methods, and show that some local quantities are handled better by our sample-adaptive real-time framework. Decoding performance is also compared with multi-day experimental data from 2 subjects, totaling 19 sessions, with and without [Formula: see text] filtering of the raw data. SIGNIFICANCE: The proposed method allows real-time adaptive artifact removal for EEG-based closed-loop BMI applications and mobile EEG studies in general, thereby increasing the range of tasks that can be studied in action and context while reducing the need for discarding data due to artifacts. Significant increase in decoding performances also justify the effectiveness of the method to be used in real-time closed-loop BMI applications.},
  langid = {english},
  keywords = {Adult,Artifacts,Blinking,Electroencephalography,Exercise Test,Eye Movements,Female,Humans,Male,Scalp,Signal Processing Computer-Assisted},
  file = {/home/roxoner/Zotero/storage/5TCVZF7Y/Kilicarslan et al. - 2016 - A robust adaptive denoising framework for real-time artifact removal in scalp EEG measurements.pdf}
}

