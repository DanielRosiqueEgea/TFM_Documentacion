@incollection{sherman_EEGSignal2020,
  title = {{{EEG Signal Processing}}: {{Theory}} and {{Applications}}},
  shorttitle = {{{EEG Signal Processing}}},
  booktitle = {Neural {{Engineering}}},
  author = {Sherman, David L. and Thakor, Nitish V.},
  editor = {He, Bin},
  date = {2020},
  pages = {97--129},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-030-43395-6_3},
  url = {https://doi.org/10.1007/978-3-030-43395-6_3},
  urldate = {2026-05-06},
  abstract = {The electroencephalogram or EEG is introduced in this chapter. Properties of the EEG time series are discussed as well. These include individual frequency band descriptions, and their critical functional properties are discussed. A variety of measurement tools are introduced to assist in the frequency-based intensity measure. These include the traditional strategies of power spectrum and time-domain analysis for continuous EEG signals, and other strategies for capturing the power frequency information about the sporadic events through the Teager energy operator (TEO). For the analysis of wave features, we also consider additional time-frequency methodologies, particularly wavelets. Lastly, apparent randomness of the EEG signals lends itself to entropy or information-theoretic analysis. We discuss an entropy-based model known as information quantity or IQ which is shown to reflect the changes in EEG from healthy, to injury, to recovering states. As a case study, we examine the use of EEG signal processing methods as a diagnostic tool in the recovery of the brain after cardiac arrest which causes global ischemic brain injury. The corresponding experiments demonstrate the importance of spectral methods to analyze the EEG frequency and amplitude variability assessed through the IQ measure and TEO as a tool to detect the burst suppression events in the experimental models of cardiac arrest. Our review of the EEG methods and the principled discoveries coming out of our experiments provide a general introduction to the basic properties of the EEG data interpretation and clinical translation.},
  isbn = {978-3-030-43395-6},
  langid = {english},
  keywords = {Autoregressive (AR),Cardiac arrest,Electroencephalogram,Entropy,Fast Fourier transform (FFT),Parametric,Spectral Analysis,Wavelets},
  file = {/home/roxoner/Zotero/storage/W6XSJRBZ/Sherman y Thakor - 2020 - EEG Signal Processing Theory and Applications.pdf}
}

@article{shin_WearableEEG2022,
  title = {Wearable {{EEG}} Electronics for a {{Brain}}–{{AI Closed-Loop System}} to Enhance Autonomous Machine Decision-Making},
  author = {Shin, Joo Hwan and Kwon, Junmo and Kim, Jong Uk and Ryu, Hyewon and Ok, Jehyung and Joon Kwon, S. and Park, Hyunjin and Kim, Tae-il},
  date = {2022-05-30},
  journaltitle = {npj Flexible Electronics},
  shortjournal = {npj Flex Electron},
